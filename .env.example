# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or any Postgres provider)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# ─── Session ────────────────────────────────────────────────────────────────
# Random secret used to sign Express session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=replace_with_a_long_random_string

# ─── Authorize.net (Payment Processing) ─────────────────────────────────────
# Obtain from https://developer.authorize.net/
AUTHORIZE_NET_API_LOGIN_ID=your_api_login_id
AUTHORIZE_NET_TRANSACTION_KEY=your_transaction_key
AUTHORIZE_NET_CLIENT_KEY=your_client_key

# Set to "production" for live payments, anything else uses the sandbox
AUTHORIZE_NET_ENV=sandbox

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Obtain from https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These are exposed to the browser — prefix MUST be VITE_
VITE_AUTHORIZE_NET_API_LOGIN_ID=your_api_login_id
VITE_AUTHORIZE_NET_CLIENT_KEY=your_client_key
# Set to "production" for live card processing in the browser
VITE_AUTHORIZE_NET_ENV=sandbox
