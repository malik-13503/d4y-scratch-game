# Disable package caching and resolve installation issues
registry=https://registry.npmjs.org/
cache=false
fetch-retries=5
fetch-retry-maxtimeout=60000
fetch-retry-mintimeout=10000
prefer-offline=false
save-exact=true
package-lock=true

# Environment variables to disable caching during deployment
progress=false
loglevel=warn
fund=false

# Clean install
install.ignore-scripts=false